{
  "name": "pptx-slide-viewer",
  "displayName": "PPTX Viewer & PowerPoint Preview, PPT Presentation Slideshow",
  "description": "Free, offline, no LibreOffice. Present with notes. PPTX viewer, PPT viewer and PowerPoint slide viewer for .pptx, .ppsx, .potx and old .ppt decks: full screen, thumbnails, search, copy a slide as PNG or Markdown. Reloads when a script or AI agent saves the deck.",
  "version": "0.5.1",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#3B1F14",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pptx viewer",
    "powerpoint viewer",
    "slide viewer",
    "ppt viewer",
    "pptx preview",
    "powerpoint preview",
    "pptx",
    "powerpoint",
    "ppt",
    "slides",
    "presentation",
    "presentation viewer",
    "present",
    "slideshow",
    "slide deck",
    "ppsx",
    "potx",
    "pptm",
    "pps",
    "powerpoint 97",
    "office viewer",
    "microsoft office",
    "speaker notes",
    "thumbnails",
    "outline",
    "pptx to markdown",
    "slide to png",
    "live reload",
    "preview",
    "offline"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "pptxViewer.preview",
        "displayName": "PPTX Slide Viewer",
        "selector": [
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.ppsx"
          },
          {
            "filenamePattern": "*.potx"
          },
          {
            "filenamePattern": "*.pptm"
          },
          {
            "filenamePattern": "*.ppt"
          },
          {
            "filenamePattern": "*.pps"
          },
          {
            "filenamePattern": "*.pot"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pptxViewer.copySlideMarkdown",
        "title": "Copy Slide Text as Markdown",
        "category": "PPTX",
        "icon": "$(markdown)"
      },
      {
        "command": "pptxViewer.copyDeckMarkdown",
        "title": "Copy All Slides as Markdown",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.copySlidePng",
        "title": "Copy Slide as PNG Picture",
        "category": "PPTX",
        "icon": "$(file-media)"
      },
      {
        "command": "pptxViewer.saveSlidePng",
        "title": "Save Slide as PNG…",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.find",
        "title": "Search Slides and Notes",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.toggleNotes",
        "title": "Toggle Speaker Notes",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.zoomIn",
        "title": "Zoom In",
        "category": "PPTX",
        "icon": "$(zoom-in)"
      },
      {
        "command": "pptxViewer.zoomOut",
        "title": "Zoom Out",
        "category": "PPTX",
        "icon": "$(zoom-out)"
      },
      {
        "command": "pptxViewer.zoomFit",
        "title": "Zoom to Fit Slide",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.zoomWidth",
        "title": "Zoom to Fit Width",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.zoomActual",
        "title": "Zoom to 100%",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.toggleScrollView",
        "title": "Toggle Scroll View (All Slides in One Column)",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.openWith",
        "title": "Open with PPTX Slide Viewer",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.supportDeveloper",
        "title": "Support the developer",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.moreViewers",
        "title": "More free viewers",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.present",
        "title": "Present Slides (Full Screen)",
        "category": "PPTX",
        "icon": "$(play)"
      },
      {
        "command": "pptxViewer.exportMenu",
        "title": "Export (Pro)...",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.exportSlidesPng",
        "title": "Export All Slides as PNG (Pro)...",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.exportPdf",
        "title": "Export Deck as PDF (Pro)...",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.decksToMarkdown",
        "title": "Convert Decks in a Folder to Markdown with Notes (Pro)...",
        "category": "PPTX"
      },
      {
        "command": "pptxViewer.getPro",
        "title": "Get Zovo Pro (USD 19 once, all 22 Zovo extensions)",
        "category": "Zovo Pro"
      },
      {
        "command": "pptxViewer.payWithPayPal",
        "title": "Pay for Zovo Pro with PayPal (USD 19, team of 5 USD 59)",
        "category": "Zovo Pro"
      },
      {
        "command": "pptxViewer.unlockWithSponsors",
        "title": "I already paid: unlock with GitHub Sponsors",
        "category": "Zovo Pro"
      },
      {
        "command": "pptxViewer.enterLicenseKey",
        "title": "Enter Zovo Pro license key",
        "category": "Zovo Pro"
      },
      {
        "command": "pptxViewer.removeLicense",
        "title": "Remove Zovo Pro from this editor",
        "category": "Zovo Pro"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pptxViewer.copySlideMarkdown",
          "when": "activeCustomEditorId == pptxViewer.preview",
          "group": "navigation"
        },
        {
          "command": "pptxViewer.present",
          "when": "activeCustomEditorId == pptxViewer.preview",
          "group": "navigation"
        },
        {
          "command": "pptxViewer.exportMenu",
          "when": "activeCustomEditorId == pptxViewer.preview && config.pptxViewer.showProFeatures",
          "group": "1_pro@1"
        }
      ],
      "explorer/context": [
        {
          "command": "pptxViewer.openWith",
          "when": "resourceExtname =~ /^\\.(pptx|ppsx|potx|pptm|ppt|pps|pot)$/i",
          "group": "navigation@99"
        },
        {
          "command": "pptxViewer.decksToMarkdown",
          "when": "explorerResourceIsFolder && !isWeb && config.pptxViewer.showProFeatures",
          "group": "7_modification@90"
        }
      ],
      "commandPalette": [
        {
          "command": "pptxViewer.copySlideMarkdown",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.copyDeckMarkdown",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.find",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.toggleNotes",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.zoomIn",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.zoomOut",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.zoomFit",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.zoomWidth",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.zoomActual",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.toggleScrollView",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.present",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.copySlidePng",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.saveSlidePng",
          "when": "activeCustomEditorId == pptxViewer.preview"
        },
        {
          "command": "pptxViewer.exportMenu",
          "when": "activeCustomEditorId == pptxViewer.preview && config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.exportSlidesPng",
          "when": "activeCustomEditorId == pptxViewer.preview && config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.exportPdf",
          "when": "activeCustomEditorId == pptxViewer.preview && config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.decksToMarkdown",
          "when": "config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.unlockWithSponsors",
          "when": "config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.getPro",
          "when": "config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.enterLicenseKey",
          "when": "config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.removeLicense",
          "when": "config.pptxViewer.showProFeatures"
        },
        {
          "command": "pptxViewer.payWithPayPal",
          "when": "config.pptxViewer.showProFeatures"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pptxViewer.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == pptxViewer.preview && !sideBarFocus && !panelFocus && !inQuickOpen"
      },
      {
        "command": "pptxViewer.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == pptxViewer.preview && !sideBarFocus && !panelFocus && !inQuickOpen"
      },
      {
        "command": "pptxViewer.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeCustomEditorId == pptxViewer.preview && !sideBarFocus && !panelFocus && !inQuickOpen"
      },
      {
        "command": "pptxViewer.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == pptxViewer.preview && !sideBarFocus && !panelFocus && !inQuickOpen"
      }
    ],
    "configuration": {
      "title": "PPTX Slide Viewer",
      "properties": {
        "pptxViewer.maxFileSizeMB": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "Ask before opening decks larger than this, in MB."
        },
        "pptxViewer.showNotes": {
          "type": "boolean",
          "default": true,
          "description": "Show the speaker notes under the slide."
        },
        "pptxViewer.renderSlides": {
          "type": "boolean",
          "default": true,
          "description": "Draw the slides. Turn off to show only the text outline and notes, which is faster for very large decks."
        },
        "pptxViewer.defaultView": {
          "type": "string",
          "enum": [
            "slide",
            "scroll"
          ],
          "enumDescriptions": [
            "One slide at a time, with the speaker notes under it.",
            "All slides in one column that you scroll, like a document."
          ],
          "default": "slide",
          "description": "How a deck opens the first time. The Scroll button switches, and each file keeps its last choice."
        },
        "pptxViewer.defaultZoom": {
          "type": "string",
          "enum": [
            "fit",
            "width"
          ],
          "enumDescriptions": [
            "The whole slide fits in the editor.",
            "The slide is as wide as the editor."
          ],
          "default": "fit",
          "description": "Zoom a deck opens with the first time. Each file keeps its last zoom."
        },
        "pptxViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a rating after 2 files opened without an error in 2 sessions at least 4 hours apart. \"Rate it\" opens the Marketplace review page in VS Code and the Open VSX one in Cursor, Windsurf and VSCodium. \"Later\" asks one more time after 7 days, \"No thanks\" never asks again. It never asks after an error or more than 2 times. Nothing is sent anywhere."
        },
        "pptxViewer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the bottom of the viewer. The change shows in files you open next. Nothing is sent anywhere."
        },
        "pptxViewer.presentFullScreen": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Present switches VS Code to Zen Mode (full screen, no side bars) and back when you press Esc. Set to `false` to present inside the editor only."
        },
        "pptxViewer.showProFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Show the Zovo Pro exports (all slides as PNG, the deck as PDF, decks in a folder to Markdown) and the Zovo Pro commands. Turn off to hide them. Everything free stays visible."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "pptxViewer.start",
        "title": "Get started with PPTX Slide Viewer",
        "description": "Open a deck, read the notes, search every slide and copy the text as Markdown.",
        "steps": [
          {
            "id": "open",
            "title": "Open a deck",
            "description": "Click any .pptx, .ppsx or .potx file in the Explorer. It opens in this viewer.\n[Open a deck](command:pptxViewer.openWith)",
            "media": {
              "image": "images/screenshot-slides.png",
              "altText": "A deck open in the viewer with thumbnails on the left and notes under the slide."
            },
            "completionEvents": [
              "onCommand:pptxViewer.openWith"
            ]
          },
          {
            "id": "search",
            "title": "Search slides and notes",
            "description": "Press Ctrl+F (Cmd+F on macOS) and type. The Outline tab lists every slide whose title, text or notes match.\n[Search](command:pptxViewer.find)",
            "media": {
              "markdown": "walkthrough/search.md"
            },
            "completionEvents": [
              "onCommand:pptxViewer.find"
            ]
          },
          {
            "id": "markdown",
            "title": "Copy slide text as Markdown",
            "description": "The Markdown button copies the title, bullets, tables and notes of the slide. Paste them into a README, an issue or a chat.\n[Copy slide as Markdown](command:pptxViewer.copySlideMarkdown)",
            "media": {
              "markdown": "walkthrough/markdown.md"
            },
            "completionEvents": [
              "onCommand:pptxViewer.copySlideMarkdown"
            ]
          },
          {
            "id": "zovo-related",
            "title": "Files that often come with PowerPoint decks",
            "description": "If your project also has Word documents or spreadsheets and CSV files, these free Zovo extensions open them. A link opens the extension page, and you choose there whether to install it.\n[Office Viewer Pack](command:extension.open?%5B%22zovo.zovo-file-viewers%22%5D)\n[DOCX Viewer](command:extension.open?%5B%22zovo.docx-viewer-vscode%22%5D)\n[XLSX and CSV Viewer](command:extension.open?%5B%22zovo.table-viewer-vscode%22%5D)",
            "media": {
              "markdown": "walkthrough/related.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:browser": "python3 test/e2e/run.py",
    "package": "node scripts/build.js && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx -y @vscode/vsce@3 package --no-dependencies -o dist/"
  },
  "homepage": "https://github.com/theluckystrike/pptx-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/pptx-viewer-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/pptx-viewer-vscode.git"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pptx-preview": "1.0.7"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike/sponsorships?tier_id=679878"
  }
}
